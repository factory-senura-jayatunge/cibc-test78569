{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Each line of business's index.js is its public surface (AGENTS.md), so its exports count as used.
  "entry": ["scripts/*.js", "tests/*.test.js", "public/app.js", "src/lob/*/index.js"],
  "project": ["src/**/*.js", "scripts/**/*.js", "tests/**/*.js", "public/**/*.js"],
  "ignoreIssues": {
    // Known unused exports in release-baseline files: OrderError, MANDATES, loanToValue.
    // Removing them is a code change that widens scoped regression, so it is deferred to the
    // next change that touches each file. Delete the entry when you do.
    "src/lob/investors-edge/trading.js": ["exports"],
    "src/lob/pic/mandates.js": ["exports"],
    "src/lob/private-banking/credit.js": ["exports"],
  },
}
