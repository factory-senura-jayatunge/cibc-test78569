{
  "name": "cibc-wealth-pov",
  "version": "1.0.0",
  "private": true,
  "description": "Synthetic wealth-platform monolith (OBR-style) for a Factory point-of-view demo. No CIBC code or data.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=90 \"tests/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "deadcode": "knip",
    "duplication": "jscpd",
    "docs:check": "node scripts/check-docs.js",
    "files:check": "node scripts/check-file-size.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run deadcode && npm run duplication && npm run docs:check && npm run files:check && npm run test:coverage",
    "regression:full": "node scripts/regression.js --all",
    "regression:scoped": "node scripts/regression.js --from-impact out/impact.json",
    "impact": "node scripts/impact.js",
    "coupling": "node scripts/coupling.js",
    "profile": "node scripts/profile.js",
    "release:pack": "node scripts/release-pack.js",
    "baseline": "node scripts/baseline.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.12.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,jsonc,css,html,yml,yaml}": [
      "prettier --check"
    ]
  }
}
