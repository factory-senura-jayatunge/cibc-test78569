# Copy to .env for local overrides; .env is gitignored. Every variable is optional.
# `npm start` loads .env at startup. A variable already set in your shell takes precedence.
# OBR holds no secrets. If one is ever needed, read it from the environment and store it in the
# CI secret store (GitHub Actions secrets) or your OS keychain, never in this repository.

# HTTP port for `npm start`.
PORT=3000

# Structured log level: debug, info, warn, error, or silent. `npm start` defaults to info.
LOG_LEVEL=info

# Set to 1 to mirror audit events to stdout. Known gap: audit detail includes client names (SECURITY.md).
AUDIT_STDOUT=0
